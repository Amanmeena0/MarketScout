# ==============================================================================
# LLM Provider Configuration
# Options: 'ollama', 'google', 'groq', 'huggingface', 'jan'
# ==============================================================================
LLM_PROVIDER="ollama"

# ==============================================================================
# Cloud API Keys
# ==============================================================================
# Gemini API Integration
GOOGLE_API_KEY=""
# Rate limit requests per second for Free Tier (e.g. 0.1 for 1 request per 10s). Set to 0 or leave empty to disable.
GOOGLE_RATE_LIMIT_RPS="0.5"

# Groq API
GROQ_API_KEY=""

# Hugging Face API
HUGGINGFACEHUB_API_TOKEN=""

# ==============================================================================
# Search & External Data Source Keys
# ==============================================================================
SERP_DEV_API_KEY=""
SERP_API_KEY=""
NEWS_API_KEY=""
YOUTUBE_API_KEY=""
X_API_KEY=""
X_SECRET_API_KEY=""
X_BEARER_TOKEN=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""

# ==============================================================================
# LangSmith Tracing & Observability
# ==============================================================================
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="MarketScout"

# ==============================================================================
# Local Model URLs & Providers
# ==============================================================================
OLLAMA_BASE_URL="http://localhost:11434"
JAN_API_BASE="http://localhost:1337/v1"

# ==============================================================================
# Default / Fallback Model References
# ==============================================================================
GOOGLE_MODEL="gemini-2.0-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
MULTIPURPOSE_MODEL="llama3.2:3b"

# ==============================================================================
# Component-Specific Pipeline Models
#
# Fast / Low-Pressure Local Options (via Ollama):
#   - llama3.2:3b   (2.0 GB - Recommended: fast, high quality, minimal RAM pressure)
#   - gemma3:1b     (815 MB - Ultra-lightweight & fastest)
#   - phi3:mini     (2.2 GB - Fast & capable)
#
# High Performance Cloud Options (set LLM_PROVIDER="google" or "groq"):
#   - gemini-2.0-flash
#   - llama-3.3-70b-versatile
# ==============================================================================
PLANNER_MODEL="llama3.2:3b"
TOOL_ROUTING_MODEL="llama3.2:3b"
SUMMARIZATION_MODEL="llama3.2:3b"
EVIDENCE_ANALYSIS_MODEL="llama3.2:3b"
REPORT_WRITING_MODEL="llama3.2:3b"
REPORT_REVIEW_MODEL="llama3.2:3b"

# ==============================================================================
# Database Configuration
# ==============================================================================
MONGO_DB_URI=""
