# LLM Provider Configuration ('google' or 'huggingface')
LLM_PROVIDER=google

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
# Rate limit requests per second for Free Tier (e.g. 0.1 for 1 request per 10s). Set to 0 or leave empty to disable.
GOOGLE_RATE_LIMIT_RPS=0.1

# Hugging Face Configurations
HUGGINGFACEHUB_API_TOKEN=

SERP_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_SECRET=
SERP_DEV_API_KEY=
NEWS_API_KEY=

REDDIT_USERNAME=
REDDIT_PASSWORD=


LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""


# Multi-Model Pipeline Configuration
PLANNER_MODEL=gemini-2.0-flash
TOOL_ROUTING_MODEL=Qwen/Qwen3-32B
SUMMARIZATION_MODEL=deepseek-ai/DeepSeek-V3
EVIDENCE_ANALYSIS_MODEL=Qwen/Qwen3-32B
REPORT_WRITING_MODEL=gemini-2.0-flash
REPORT_REVIEW_MODEL=deepseek-ai/DeepSeek-V3

MONGO_DB_URI=